<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" lang="en">
<head>
<meta charset="UTF-8" />
<title>Competency report {{caseNumber}}</title>
<style>
  body { font-family: sans-serif; font-size: 11pt; color: #222; margin: 1.5em; }
  h1 { font-size: 18pt; margin-bottom: 0; } h2 { font-size: 13pt; border-bottom: 1px solid #999; margin-top: 1.4em; }
  table { border-collapse: collapse; width: 100%; } th, td { border: 1px solid #bbb; padding: 4px 6px; text-align: left; vertical-align: top; font-size: 10pt; }
  .meta td { border: none; padding: 1px 6px 1px 0; } .gap { color: #b00020; font-weight: bold; }
  .box { border: 1px solid #999; padding: 6px 10px; margin: 6px 0; } .ai { background: #eef3ff; } .human { background: #f3f9f0; }
  .note { font-size: 9pt; color: #555; } .pre { white-space: pre-wrap; }
</style>
</head>
<body>
<h1>Competency Report</h1>
<p class="note">Case {{caseNumber}} · generated {{generatedAt}}</p>
<table class="meta">
  <tr><td><b>Candidate</b></td><td>{{workerName}} ({{workerPhone}})</td></tr>
  <tr><td><b>Declared trade</b></td><td>{{trade}}, {{experienceYears}} years</td></tr>
  <tr><td><b>Qualification</b></td><td>{{qualification.code}} v{{qualification.version}} – {{qualification.title}} (NSQF {{qualification.nsqf}}, {{qualification.trade}})</td></tr>
  <tr><td><b>Qualification source</b></td><td>{{qualification.source}}</td></tr>
</table>

<h2>Competency scores</h2>
<table>
  <tr><th>Competency</th><th>Score</th><th>Assessor comment</th><th>Evidence</th></tr>
  {{#each rows}}
  <tr>
    <td>{{code}} – {{title}}{{#if mandatory}} <i>(mandatory)</i>{{/if}}</td>
    <td>{{#if scored}}{{score}} / {{max}} ({{percent}}%){{else}}<span class="gap">Not scored</span>{{/if}}</td>
    <td class="pre">{{comment}}</td>
    <td>{{#each evidence}}{{this}}<br />{{else}}<span class="note">none attached</span>{{/each}}</td>
  </tr>
  {{/each}}
</table>
<p>Total: {{total}} / {{max}}</p>

<h2>Missing requirements</h2>
{{#if missing}}<ul>{{#each missing}}<li>{{this}}</li>{{/each}}</ul>{{else}}<p>None.</p>{{/if}}

<h2>Skill gaps (scored below {{gapPercent}}%)</h2>
{{#if gaps}}<ul>{{#each gaps}}<li>{{this}}</li>{{/each}}</ul>{{else}}<p>None.</p>{{/if}}

<h2>Assessor findings</h2>
<div class="box human">
  {{#if submission}}
  <p><b>Recommendation:</b> {{submission.recommendation}}</p>
  <p class="pre">{{submission.notes}}</p>
  {{else}}<p>Not yet submitted.</p>{{/if}}
  <p class="note">Entered by the assessor.</p>
</div>

<h2>AI-generated summary</h2>
<div class="box ai">
  {{#if aiSummary}}<p class="pre">{{aiSummary}}</p>{{else}}<p>No AI summary available.</p>{{/if}}
  <p class="note">Generated by AI from the assessor's recorded data. It is advisory only: a recommendation, not an official certification decision.</p>
</div>

<h2>Decision</h2>
<div class="box">
  {{#if decision}}
  <p><b>Outcome:</b> {{decision.outcome}}</p>
  <p class="pre">{{decision.rationale}}</p>
  <p class="note">Recorded by {{decision.decidedBy}} on {{decision.decidedAt}}.</p>
  {{else}}<p>Pending decision by an authorised decision-maker.</p>{{/if}}
</div>
<p class="note">This report does not constitute a certificate. Certification is issued only by the authorised body.</p>
</body>
</html>
